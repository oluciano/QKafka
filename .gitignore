## Ignore Visual Studio temporary files, build results, and
## files generated by popular IDEs.

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa]rm/
[Aa]rm64/
bld/
[Bb]in/
[Oo]bj/
[Log]/
[Ll]og/

# Visual Studio Virtual Space Settings
.vs/

# User-specific files
*.rsuser
*.suo
*.user
*.userStyles
*.usertasks
*.cache
*.db

# NuGet Packages
*.nupkg
[Nn]upkg/
# The packages folder can be ignored because of Package Restore
**/packages/*
# except build/, etc.
!**/packages/build/

# Microsoft SQL Server files
*.mdf
*.ldf
*.ndf

# JetBrains Rider
.idea/
*.sln.iml

# Visual Studio Code
.vscode/

# OS-generated files
.DS_Store
Thumbs.db

# ── GSD baseline (auto-generated) ──
.gsd
.gsd-id
.mcp.json
.bg-shell/
nul
nul.*
con
con.*
prn
prn.*
aux
aux.*
com[1-9]
com[1-9].*
lpt[1-9]
lpt[1-9].*
*.swp
*.swo
*~
*.code-workspace
.env
.env.*
!.env.example
node_modules/
.next/
dist/
build/
__pycache__/
